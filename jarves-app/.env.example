# OpenAI (optional if you want to use OpenAI instead of Gemini)
OPENAI_API_KEY=your_api_key_here

# Gemini API (set USE_GEMINI=true to use Gemini instead of OpenAI)
USE_GEMINI=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=text-bison-001

# G0DM0D3 (Multi-AI Race)
USE_GODMODE=false
OPENROUTER_API_KEY=
GODMODE_BASE_URL=http://localhost:7860/v1

PORT=3000
