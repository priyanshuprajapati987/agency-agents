{
  "version": 2,
  "builds": [
    {
      "src": "jarves-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "jarves-app/dist/$1"
    }
  ],
  "env": {
    "VERCEL": "1"
  }
}
